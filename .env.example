# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
ANTHROPIC_API_KEY=
LINEAR_API_KEY=
# Optional: Linear team key or name for new issues. Blank means the first team (both services).
LINEAR_TEAM_KEY=
# Optional: Slack incoming-webhook URL for Account Watch's weekly digest. Blank prints it instead.
SLACK_WEBHOOK_URL=
